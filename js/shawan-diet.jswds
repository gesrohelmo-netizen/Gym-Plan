/* ============================================================
   PART 4/5
   Rendering Engine + Person Switching + UI Logic
============================================================ */
/* ============================================================
   PART 4/5
   Rendering Engine + Person Switching + UI Logic
============================================================ */

function getCurrentDiet() {
    return selectedPerson === "umar" ? umarDiet : haziqDiet;
}

function createMealHTML(meal) {

    return `
        <div class="meal-item">

            <div class="meal-left">

                <h4>${meal.name}</h4>

                <span>${meal.time}</span>

            </div>

            <div class="meal-right">

                <strong>${meal.food}</strong>

            </div>

        </div>
    `;

}

function createDayHTML(day) {

    let meals = "";

    day.meals.forEach(meal => {

        meals += createMealHTML(meal);

    });

    return `

        <div class="glass-card diet-day-card">

            <div class="card-header">

                <h2>${day.day}</h2>

                <span class="text-green">${day.calories}</span>

            </div>

            ${meals}

        </div>

    `;

}

function renderDiet() {

    const container = $("weeklyDietContainer");

    if (!container) return;

    container.innerHTML = "";

    const diet = getCurrentDiet();

    diet.forEach(day => {

        container.innerHTML += createDayHTML(day);

    });

}

function setActiveButton() {

    const umarBtn = $("umarBtn");
    const haziqBtn = $("haziqBtn");

    if (!umarBtn || !haziqBtn) return;

    if (selectedPerson === "umar") {

        umarBtn.classList.add("active");
        haziqBtn.classList.remove("active");

    } else {

        haziqBtn.classList.add("active");
        umarBtn.classList.remove("active");

    }

}

function updateEverything() {

    updateProfileCards();

    renderRecommendation();

    renderGroceries();

    renderDiet();

    setActiveButton();

}

function switchPerson(person) {

    if (!dietProfiles[person]) return;

    selectedPerson = person;

    savePerson(person);

    updateEverything();

}

function setupButtons() {

    const umarBtn = $("umarBtn");
    const haziqBtn = $("haziqBtn");

    if (umarBtn) {

        umarBtn.addEventListener("click", () => {

            switchPerson("umar");

        });

    }

    if (haziqBtn) {

        haziqBtn.addEventListener("click", () => {

            switchPerson("haziq");

        });

    }

}

function setupThemeButton() {

    const themeBtn = $("themeBtn");

    if (!themeBtn) return;

    themeBtn.addEventListener("click", () => {

        document.body.classList.toggle("light-mode");

    });

}

/* ============================================================
   PART 5/5
   Initialization + Final Startup
============================================================ */
