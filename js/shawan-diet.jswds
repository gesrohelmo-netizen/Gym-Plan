}

function createMealHTML(meal) {

    return `
        <div class="meal-item">

            <div class="meal-left">

                <h4>${meal.name}</h4>

                <span>${meal.time}</span>

            </div>

            <div class="meal-right">

                <strong>${meal.food}</strong>

            </div>

        </div>
    `;

}

function createDayHTML(day) {

    let meals = "";

    day.meals.forEach(meal => {

        meals += createMealHTML(meal);

    });

    return `

        <div class="glass-card diet-day-card">

            <div class="card-header">

                <h2>${day.day}</h2>

                <span class="text-green">${day.calories}</span>

            </div>

