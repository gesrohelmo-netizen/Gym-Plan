   GymDietPro
   Shawan Diet System
   Part 1/5
============================================================ */

const dietProfiles = {

    umar: {

        id: "umar",

        name: "Umar",

        age: 17,

        height: "5'7\"",

        weight: 56,

        bodyFat: "13–14%",

        goal: "Lean Bulk",

        calories: 2550,

        protein: 145,

        carbs: 330,

        fats: 65,

        water: 3.5,

        budget: "Rs.650–850 / day"

    },

    haziq: {

        id: "haziq",

        name: "Haziq",

        age: 17,

        height: "5'10\"",

        weight: 52,

        bodyFat: "11–12%",

        goal: "Lean Bulk",

        calories: 2750,

        protein: 160,

        carbs: 365,

        fats: 70,

        water: 4,

        budget: "Rs.750–950 / day"

    }

};



const groceryLists = {

    umar: [

        "1.8 kg Chicken Breast",

        "3.5 kg Rice",

        "700 g Oats",

        "14 L Milk",

        "2.5 kg Homemade Yogurt",

        "18 Bananas",

        "250 g Peanuts",

        "1 kg Daal",

        "Seasonal Vegetables",

        "Chapati Flour"

    ],

    haziq: [

        "2.2 kg Chicken Breast",

        "4.2 kg Rice",

        "900 g Oats",

        "17 L Milk",

        "3 kg Homemade Yogurt",

        "22 Bananas",

        "350 g Peanuts",

        "1.3 kg Daal",

        "Seasonal Vegetables",

        "Chapati Flour"

    ]

};



const recommendations = {

    umar: {

        title: "Umar's Lean Bulk Plan",

        text: "Stay around 2550 kcal daily. Focus on high protein, controlled fats and clean carbs. Target muscle gain while keeping abs visible."

    },

    haziq: {

        title: "Haziq's Lean Bulk Plan",

        text: "Because of your height and weight, eat larger portions consistently. Prioritize rice, chicken and milk to gain lean mass."

    }

};



function $(id){

    return document.getElementById(id);

}



function savePerson(person){

    localStorage.setItem(

        "selectedDietPerson",

        person

    );

}



function loadPerson(){

    return localStorage.getItem(

        "selectedDietPerson"

    ) || "umar";

}



let selectedPerson = loadPerson();



function currentProfile(){

    return dietProfiles[selectedPerson];

}



function updateProfileCards(){

    const p = currentProfile();

    if($("currentPerson"))
        $("currentPerson").textContent = p.name;

    if($("dietWeight"))
        $("dietWeight").textContent = p.weight + " kg";

    if($("dietHeight"))
        $("dietHeight").textContent = p.height;

    if($("dietCalories"))
        $("dietCalories").textContent = p.calories;

    if($("dietProtein"))
        $("dietProtein").textContent = p.protein + "g";

    if($("goalCalories"))
        $("goalCalories").textContent = p.calories + " kcal";

    if($("goalProtein"))
        $("goalProtein").textContent = p.protein + " g";

    if($("goalCarbs"))
        $("goalCarbs").textContent = p.carbs + " g";

    if($("goalFats"))
        $("goalFats").textContent = p.fats + " g";

    if($("waterTarget"))
        $("waterTarget").textContent = p.water + " Litres";

}



function renderRecommendation(){

    const p = recommendations[selectedPerson];

    if($("recommendationTitle"))
        $("recommendationTitle").textContent = p.title;

    if($("recommendationText"))
        $("recommendationText").textContent =

        p.text +

        "\n\nEstimated Budget: " +

        currentProfile().budget;

}



function renderGroceries(){

    const box = $("shoppingList");

    if(!box) return;

    box.innerHTML = "";

    groceryLists[selectedPerson].forEach(item=>{

        box.innerHTML += `

        <div class="meal-item">

            <div class="meal-left">

                <h4>${item}</h4>

                <span>Weekly Grocery</span>

            </div>

        </div>

        `;

    });

}

