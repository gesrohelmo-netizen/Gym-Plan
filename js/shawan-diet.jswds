    if (!umarBtn || !haziqBtn) return;

    if (selectedPerson === "umar") {

        umarBtn.classList.add("active");
        haziqBtn.classList.remove("active");

    } else {

        haziqBtn.classList.add("active");
        umarBtn.classList.remove("active");

    }

}

function updateEverything() {

    updateProfileCards();

    renderRecommendation();

    renderGroceries();

